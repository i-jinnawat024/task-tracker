// Task Tracker — Prisma schema
//
// DB = Prisma Postgres (endpoint เดียว ไม่ต้องแยก pooled/direct url)
// ถ้าย้ายไป Supabase/Neon ที่มี pgbouncer ต้องเพิ่ม directUrl = env("DIRECT_URL")
// สำหรับ migrate เพราะ transaction pooler รัน DDL ไม่ได้

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  todo
  doing
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum MemberRole {
  owner
  editor
}

model User {
  id String @id @default(uuid()) @db.Uuid
  /// เก็บ lowercase เสมอ (normalizeEmail) เพื่อให้ unique constraint ทำงานจริง
  email        String   @unique
  /// รูปแบบ "scrypt$N$r$p$saltB64$hashB64" — ดู src/lib/auth/password.ts
  passwordHash String   @map("password_hash")
  displayName  String?  @map("display_name")
  /// สมัครแล้วยังใช้งานไม่ได้จนกว่าแอดมินจะเปลี่ยนเป็น true เอง (manual approve ผ่าน DB)
  isApproved   Boolean  @default(false) @map("is_approved")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sessions       Session[]
  passwordResets PasswordReset[]
  ownedLists     List[]       @relation("ListOwner")
  memberships    ListMember[]
  createdTasks   Task[]       @relation("TaskCreator")
  assignedTasks  Task[]       @relation("TaskAssignee")

  @@map("users")
}

/// ลิงก์ตั้งรหัสใหม่ — เก็บ sha256 ของ token เหมือน session
/// usedAt ทำให้ลิงก์ใช้ได้ครั้งเดียว (ไม่ลบทิ้งทันทีเพื่อบอกผู้ใช้ได้ว่า "ใช้ไปแล้ว"
/// แทนที่จะขึ้นว่า "ลิงก์ไม่ถูกต้อง" ซึ่งทำให้คนงงว่าพิมพ์ผิดหรืออะไร)
model PasswordReset {
  tokenHash String    @id @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_resets")
}

/// session แบบ opaque token เก็บใน DB — เลือกแบบนี้แทน JWT เพราะ
/// เพิกถอนได้ทันที (กด "ออกจากระบบ" แล้วจบจริง) และเรามี DB อยู่แล้ว
model Session {
  /// sha256 ของ token ที่อยู่ใน cookie — ถ้า DB รั่วก็ปลอม session ไม่ได้
  tokenHash  String   @id @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model List {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(80)
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner   User         @relation("ListOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members ListMember[]
  tasks   Task[]

  @@index([ownerId])
  @@map("lists")
}

model ListMember {
  listId   String     @map("list_id") @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  role     MemberRole @default(editor)
  joinedAt DateTime   @default(now()) @map("joined_at") @db.Timestamptz(6)

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([listId, userId])
  @@index([userId])
  @@map("list_members")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  listId      String       @map("list_id") @db.Uuid
  title       String       @db.VarChar(200)
  notes       String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  taskType    String       @default("task") @map("task_type") @db.VarChar(20)
  startDate   DateTime?    @map("start_date") @db.Date
  /// เก็บเป็น `date` ไม่ใช่ timestamp — วันครบกำหนดไม่ควรขึ้นกับ timezone
  dueDate     DateTime?    @map("due_date") @db.Date
  assigneeId  String?      @map("assignee_id") @db.Uuid
  tags        String[]     @default([])
  createdById String       @map("created_by") @db.Uuid
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  list      List @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdBy User @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignee  User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([listId, status])
  @@index([listId, dueDate])
  @@index([assigneeId])
  @@map("tasks")
}
