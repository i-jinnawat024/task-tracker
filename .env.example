# ---------------------------------------------------------------
# Postgres — ใช้ไฟล์ .env (ไม่ใช่ .env.local) เพราะ Prisma CLI อ่านแค่ .env
# ---------------------------------------------------------------
#
# Prisma Postgres:  Console > Database > API Keys > กด Generate แล้ว copy
DATABASE_URL="postgres://<user>:<password>@pooled.db.prisma.io:5432/postgres?sslmode=require"
#
# Supabase/Neon (มี pooler):  ต้องเพิ่ม directUrl ใน schema.prisma ด้วย ดู README
# DATABASE_URL="postgresql://...pooler...:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://...:5432/postgres"
#
# ถ้ารหัสผ่านมีอักขระพิเศษต้อง URL-encode (@ = %40, # = %23, / = %2F)
# ห้าม commit .env และห้ามใส่ค่าพวกนี้ในตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_
# (ค่า NEXT_PUBLIC_* ถูกฝังลง JS bundle ที่ browser โหลดไป)
