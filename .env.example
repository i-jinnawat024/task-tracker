# ---------------------------------------------------------------
# Supabase Auth (ใช้แค่ login/session — ข้อมูลอ่านผ่าน Prisma)
# Dashboard > Project Settings > API
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------------------------------------------------------------
# Prisma → Postgres
# Dashboard > Connect > ORMs > Prisma  (กด Copy ได้ทั้ง 2 บรรทัด)
#
# DATABASE_URL = Transaction pooler  port 6543 + ?pgbouncer=true  → ใช้ตอน query
# DIRECT_URL   = Direct connection   port 5432                    → ใช้ตอน migrate
# [YOUR-PASSWORD] = database password ที่ตั้งตอนสร้าง project
#   ถ้าลืม: Project Settings > Database > Reset database password
#   ถ้ารหัสมีอักขระพิเศษ ต้อง URL-encode (@ = %40, # = %23)
# ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ใช้ไฟล์ .env ไฟล์เดียว (ไม่ใช่ .env.local) เพราะ Prisma CLI อ่านแค่ .env
# ส่วน Next.js อ่านทั้งสองอยู่แล้ว
#
# ห้าม commit .env  และห้ามใส่ service_role key / database password
# ในตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_ (ค่าพวกนั้นถูกฝังลง JS bundle)
